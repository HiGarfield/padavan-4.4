/dts-v1/;

#include "mt7621.dtsi"
#include <dt-bindings/input/input.h>
#include "mt7621-raeth-gmac2.dtsi"
#include "mt7621-pinctrl-default-gpio.dtsi"

/ {
	compatible = "iptime,a3004ns-dual", "mediatek,mt7621-soc";
	model = "ipTIME A3004NS-dual";

	chosen {
		bootargs = "console=ttyS0,57600";
	};

	leds {
		compatible = "gpio-leds";

		power {
			label = "power";
			gpios = <&gpio0 18 GPIO_ACTIVE_LOW>;
		};

		usb {
			label = "usb";
			gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;
		};
	};

	gpio-keys-polled {
		compatible = "gpio-keys-polled";
		#address-cells = <1>;
		#size-cells = <0>;
		poll-interval = <20>;

		reset {
			label = "reset";
			gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		wps {
			label = "wps";
			gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};
};

&spi0 {
	status = "okay";

	m25p80@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;
		m25p,fast-read;

		partition@0 {
			label = "Bootloader";
			reg = <0x00000 0x20000>;
		};

		partition@20000 {
			label = "Config";
			reg = <0x20000 0x10000>;
		};

		partition@30000 {
			label = "Factory";
			reg = <0x30000 0x10000>;
		};

		partition@40000 {
			label = "firmware";
			reg = <0x40000 0xf80000>;
		};

		partition@fc0000 {
			label = "Storage";
			reg = <0xfc0000 0x40000>;
		};

		partition@all {
			label = "ALL";
			reg = <0x0 0x1000000>;
		};
	};
};

&pcie {
	status = "okay";
};

&xhci {
	status = "okay";
};

&u3phy1 {
	status = "okay";
};
